CARE_RX_THERAPIST_PASSWORD_HASH=scrypt\$16384\$8\$1\$REPLACE_WITH_GENERATED_SALT\$REPLACE_WITH_GENERATED_HASH
CARE_RX_COOKIE_SECURE=true
CARE_RX_SESSION_IDLE_MINUTES=15
CARE_RX_SESSION_ABSOLUTE_MINUTES=120
