{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://care-rx.local/schemas/decision-rule.schema.json",
  "title": "CARE-Rx deterministic decision rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "version", "status", "priority", "scope", "when", "then", "rationaleCode", "clinicalReview", "tests"],
  "properties": {
    "ruleId": { "type": "string", "pattern": "^RULE-[A-Z0-9-]+$" },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "review", "approved", "retired"] },
    "priority": { "type": "integer", "minimum": 0 },
    "scope": { "type": "array", "minItems": 1, "items": { "enum": ["GLOBAL_SAFETY", "M01", "M07", "M08"] } },
    "when": { "$ref": "#/$defs/conditionGroup" },
    "then": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "enum": ["blockAll", "blockModule", "excludeCandidate", "includeCandidate", "requireInformation", "requireTherapistReview"] },
          "reference": { "type": ["string", "null"] }
        }
      }
    },
    "rationaleCode": { "type": "string" },
    "clinicalReview": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["pending_clinical_review", "approved"] } } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^TC-[A-Z0-9-]+$" } }
  },
  "$defs": {
    "condition": { "type": "object", "additionalProperties": false, "required": ["fact", "operator", "value"], "properties": { "fact": { "type": "string" }, "operator": { "enum": ["equals", "notEquals", "in", "notIn", "exists", "isUnknown"] }, "value": {} } },
    "conditionGroup": { "type": "object", "minProperties": 1, "maxProperties": 1, "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }, "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } }
  }
}
