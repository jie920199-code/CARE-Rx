{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://care-rx.local/schemas/export-package.schema.json",
  "title": "CARE-Rx therapist-confirmed export package",
  "type": "object",
  "additionalProperties": false,
  "required": ["exportId", "generatedAt", "audience", "therapistConfirmation", "contentVersions", "patientDataPolicy", "disclaimer", "items"],
  "properties": {
    "exportId": { "type": "string", "pattern": "^EXP-[A-Z0-9-]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "audience": { "enum": ["therapist", "caregiver", "resident_family"] },
    "therapistConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "therapistUserId", "confirmedAt"],
      "properties": {
        "confirmed": { "const": true },
        "therapistUserId": { "type": "string", "minLength": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contentVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentSchemaVersion", "ruleSetVersion", "prescriptionLibraryVersion", "safetyConfigVersion"],
      "properties": {
        "assessmentSchemaVersion": { "type": "string" },
        "ruleSetVersion": { "type": "string" },
        "prescriptionLibraryVersion": { "type": "string" },
        "safetyConfigVersion": { "type": "string" }
      }
    },
    "patientDataPolicy": { "const": "no_direct_identifiers_user_managed_export" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prescriptionId", "prescriptionVersion", "clinicalStatus", "renderedContent"],
        "properties": {
          "prescriptionId": { "type": "string", "pattern": "^RX-[A-Z0-9-]+$" },
          "prescriptionVersion": { "type": "string" },
          "clinicalStatus": { "const": "approved" },
          "renderedContent": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
